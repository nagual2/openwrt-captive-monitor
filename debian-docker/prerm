#!/bin/bash
set -e

# Остановить и отключить сервис
if systemctl is-active --quiet captive-daemon.service 2>/dev/null; then
    systemctl stop captive-daemon.service
fi

if systemctl is-enabled --quiet captive-daemon.service 2>/dev/null; then
    systemctl disable captive-daemon.service
fi

# Остановить и удалить контейнер
if command -v docker &>/dev/null; then
    docker stop captive-daemon 2>/dev/null || true
    docker rm captive-daemon 2>/dev/null || true
    docker rmi captive-portal-daemon:latest 2>/dev/null || true
fi

exit 0
