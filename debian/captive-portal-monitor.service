[Unit]
Description=Captive Portal Monitor Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/captive-portal-monitor
Restart=always
RestartSec=60
User=root
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/root/.Xauthority"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=captive-portal-monitor

[Install]
WantedBy=multi-user.target
