#!/bin/bash
set -e

case "$1" in
    remove|deconfigure)
        # Stop and disable daemon service
        systemctl stop captive-portal-daemon.service 2>/dev/null || true
        systemctl disable captive-portal-daemon.service 2>/dev/null || true
        
        # Remove PID file
        rm -f /tmp/captive_portal_daemon.pid
        rm -f /run/user/*/captive_portal_daemon.pid
        
        # Remove log symlink
        SYMLINK="/var/log/captive_portal_daemon.log"
        if [ -L "$SYMLINK" ]; then
            rm -f "$SYMLINK"
            echo "Removed log symlink: $SYMLINK"
        fi
        
        echo "Captive Portal Daemon stopped and disabled"
        ;;
esac

#DEBHELPER#

exit 0
