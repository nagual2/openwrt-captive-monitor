#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	# Install main script
	install -D -m 755 tools/captive_portal_wsl_selenium.py debian/openwrt-captive-monitor/usr/bin/captive-portal-monitor
	
	# Install library modules
	install -d debian/openwrt-captive-monitor/usr/lib/python3/dist-packages/captive_monitor
	install -D -m 644 tools/__init__.py debian/openwrt-captive-monitor/usr/lib/python3/dist-packages/captive_monitor/__init__.py
	install -D -m 644 tools/conn4_auth_lib.py debian/openwrt-captive-monitor/usr/lib/python3/dist-packages/captive_monitor/conn4_auth_lib.py
	install -D -m 644 tools/conn4_shared.py debian/openwrt-captive-monitor/usr/lib/python3/dist-packages/captive_monitor/conn4_shared.py
	install -D -m 644 tools/conn4_utils.py debian/openwrt-captive-monitor/usr/lib/python3/dist-packages/captive_monitor/conn4_utils.py
	install -D -m 644 tools/conn4_wbs_client.py debian/openwrt-captive-monitor/usr/lib/python3/dist-packages/captive_monitor/conn4_wbs_client.py
	install -D -m 644 tools/html_form_parser.py debian/openwrt-captive-monitor/usr/lib/python3/dist-packages/captive_monitor/html_form_parser.py
	install -D -m 644 tools/schema_utils.py debian/openwrt-captive-monitor/usr/lib/python3/dist-packages/captive_monitor/schema_utils.py
	
	# Install systemd service
	install -D -m 644 debian/captive-portal-monitor.service debian/openwrt-captive-monitor/lib/systemd/system/captive-portal-monitor.service
	
	# Install documentation
	install -D -m 644 README.md debian/openwrt-captive-monitor/usr/share/doc/openwrt-captive-monitor/README.md
	install -D -m 644 LICENSE debian/openwrt-captive-monitor/usr/share/doc/openwrt-captive-monitor/LICENSE

override_dh_auto_test:
	# Skip tests for now
