{
  "portal_type": "generic",
  "auth_method": "form_submission",
  "detection": {
    "url_patterns": [
      "*login*",
      "*auth*",
      "*portal*"
    ],
    "title_patterns": [
      "*Login*",
      "*Authentication*",
      "*WiFi*"
    ],
    "content_patterns": [
      "<form",
      "username",
      "password"
    ]
  },
  "form_config": {
    "action": "/login",
    "method": "POST",
    "required_fields": {
      "username": "Имя пользователя",
      "password": "Пароль"
    },
    "optional_fields": {
      "remember": "Запомнить меня"
    },
    "hidden_fields": {}
  },
  "success_indicators": [
    {
      "type": "http_status",
      "value": "200",
      "timeout": 10
    },
    {
      "type": "internet_check",
      "value": "http://www.google.com/generate_204",
      "timeout": 15
    }
  ],
  "retry_config": {
    "max_attempts": 3,
    "delay_seconds": 3,
    "backoff_multiplier": 2.0
  },
  "headers": {
    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
  },
  "timeouts": {
    "page_load": 20,
    "auth_request": 10,
    "verification": 8
  },
  "metadata": {
    "name": "Generic Captive Portal",
    "description": "Универсальная конфигурация для простых captive порталов с формой логин/пароль",
    "version": "1.0.0",
    "author": "OpenWrt Captive Monitor Project",
    "created": "2025-12-11T21:00:00Z",
    "updated": "2025-12-11T21:00:00Z",
    "tested_versions": [
      "Generic v1.0"
    ]
  }
}
