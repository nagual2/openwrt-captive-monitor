{
  "portal_type": "conn4.com",
  "auth_method": "javascript_emulation",
  "detection": {
    "url_patterns": [
      "*conn4.com*",
      "*conn4*"
    ],
    "title_patterns": [
      "*Internet Access*",
      "*WiFi Login*"
    ],
    "content_patterns": [
      "roomNumber",
      "accessCode",
      "validateForm"
    ]
  },
  "form_config": {
    "action": "/login.php",
    "method": "POST",
    "required_fields": {
      "roomNumber": "Номер комнаты",
      "accessCode": "Код доступа"
    },
    "optional_fields": {},
    "hidden_fields": {
      "action": "login",
      "redirect": ""
    }
  },
  "javascript_config": {
    "validation_function": "validateForm",
    "submit_function": "submitLogin",
    "required_variables": [
      "roomNumber",
      "accessCode"
    ],
    "custom_logic": "function validateForm() { return roomNumber && accessCode; }"
  },
  "success_indicators": [
    {
      "type": "redirect",
      "value": "success",
      "timeout": 10
    },
    {
      "type": "internet_check",
      "value": "http://www.google.com/generate_204",
      "timeout": 15
    }
  ],
  "retry_config": {
    "max_attempts": 3,
    "delay_seconds": 5,
    "backoff_multiplier": 1.5
  },
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.5"
  },
  "timeouts": {
    "page_load": 30,
    "auth_request": 15,
    "verification": 10
  },
  "metadata": {
    "name": "Conn4.com Hotel WiFi Portal",
    "description": "Конфигурация для captive портала conn4.com, используемого в отелях",
    "version": "1.0.0",
    "author": "OpenWrt Captive Monitor Project",
    "created": "2025-12-11T21:00:00Z",
    "updated": "2025-12-11T21:00:00Z",
    "tested_versions": [
      "conn4.com v2.1",
      "conn4.com v2.0"
    ]
  }
}
