{
  "PowerShell Script Template": {
    "prefix": "ps1-template",
    "body": [
      "# PowerShell script template",
      "# Requires: PowerShell 7+",
      "",
      "param(",
      "    [Parameter(Mandatory=$false)]",
      "    [string]$${1:Param1} = \"default\"",
      "    ",
      "    [Parameter(Mandatory=$false)]",
      "    [string]$${2:Param2}",
      ")",
      "",
      "# Error handling",
      "$ErrorActionPreference = 'Stop'",
      "",
      "# Functions",
      "function Write-Info {",
      "    param([string]$$message)",
      "    Write-Host \"INFO: $$message\" -ForegroundColor Cyan",
      "}",
      "",
      "function Write-Error-Custom {",
      "    param([string]$$message)",
      "    Write-Host \"ERROR: $$message\" -ForegroundColor Red",
      "    exit 1",
      "}",
      "",
      "function Write-Warn-Custom {",
      "    param([string]$$message)",
      "    Write-Host \"WARNING: $$message\" -ForegroundColor Yellow",
      "}",
      "",
      "# Main code",
      "Write-Info \"Starting script...\"",
      "$0"
    ],
    "description": "PowerShell script template with error handling"
  },
  "Test-Connection with Retry": {
    "prefix": "test-connection-retry",
    "body": [
      "function Test-ConnectionWithRetry {",
      "    param(",
      "        [string]$$HostName,",
      "        [int]$$MaxRetries = 5,",
      "        [int]$$DelaySeconds = 2",
      "    )",
      "    ",
      "    for ($$i = 1; $$i -le $$MaxRetries; $$i++) {",
      "        if (Test-Connection -ComputerName $$HostName -Count 1 -Quiet) {",
      "            return $$true",
      "        }",
      "        Write-Host \"Attempt $$i/$$MaxRetries failed, retrying in $$DelaySeconds seconds...\"",
      "        Start-Sleep -Seconds $$DelaySeconds",
      "    }",
      "    ",
      "    return $$false",
      "}"
    ],
    "description": "Test-Connection with retry logic"
  },
  "Docker Build Command": {
    "prefix": "docker-build",
    "body": [
      "docker build `",
      "  --build-arg OPENWRT_VERSION=${1:23.05.5} `",
      "  --build-arg SDK_TARGET=${2:x86} `",
      "  --build-arg SDK_SUBTARGET=${3:64} `",
      "  -t ${4:openwrt-sdk:local} `",
      "  -f ${5:docker/sdk/Dockerfile} `",
      "  ."
    ],
    "description": "Docker build command for OpenWrt SDK"
  },
  "GitHub CLI Workflow Run": {
    "prefix": "gh-workflow-run",
    "body": [
      "gh workflow run \"${1:Workflow Name}\" `",
      "  --ref $$(git branch --show-current) `",
      "  ${2:-f param=value}"
    ],
    "description": "GitHub CLI workflow run command"
  },
  "GitHub Actions Monitor": {
    "prefix": "gh-monitor",
    "body": [
      "# Мониторинг GitHub Actions",
      "$$runs = gh run list --limit ${1:10} --json databaseId,status,conclusion,name",
      "$$runs | jq '.[] | {id: .databaseId, status: .status, name: .name}'",
      "",
      "# Просмотр логов последнего запуска",
      "$$latestRun = $$runs | jq -r '.[0].databaseId'",
      "gh run view $$latestRun --log"
    ],
    "description": "Monitor GitHub Actions runs"
  }
}

