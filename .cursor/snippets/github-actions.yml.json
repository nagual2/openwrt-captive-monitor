{
  "GitHub Actions Workflow Template": {
    "prefix": "gha-workflow",
    "body": [
      "name: ${1:Workflow Name}",
      "",
      "on:",
      "  push:",
      "    branches:",
      "      - main",
      "  pull_request:",
      "    branches:",
      "      - main",
      "",
      "jobs:",
      "  ${2:job-name}:",
      "    runs-on: ubuntu-24.04",
      "    ",
      "    steps:",
      "      - name: Checkout",
      "        uses: actions/checkout@v4",
      "        ",
      "      - name: ${3:Step Name}",
      "        run: |",
      "          echo \"Running step...\"",
      "          $0"
    ],
    "description": "GitHub Actions workflow template"
  },
  "Matrix Build": {
    "prefix": "gha-matrix",
    "body": [
      "    strategy:",
      "      matrix:",
      "        ${1:arch}:",
      "          - {target: ${2:x86}, subtarget: ${3:64}}",
      "          - {target: ${4:ath79}, subtarget: ${5:generic}}",
      "      max-parallel: ${6:4}",
      "      fail-fast: false"
    ],
    "description": "Matrix build strategy"
  },
  "Concurrency": {
    "prefix": "gha-concurrency",
    "body": [
      "concurrency:",
      "  group: $${{ github.workflow }}-$${{ github.ref }}",
      "  cancel-in-progress: ${1:true}"
    ],
    "description": "Concurrency configuration"
  },
  "Timeout": {
    "prefix": "gha-timeout",
    "body": [
      "    timeout-minutes: ${1:30}  # Job timeout",
      "    steps:",
      "      - name: ${2:Step Name}",
      "        timeout-minutes: ${3:10}  # Step timeout"
    ],
    "description": "Timeout configuration"
  }
}

