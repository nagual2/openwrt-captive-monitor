{
  "Bash Script Template": {
    "prefix": "bash-template",
    "body": [
      "#!/bin/bash",
      "set -euo pipefail",
      "",
      "# Отключить все интерактивные режимы",
      "export GIT_PAGER=cat",
      "export PAGER=cat",
      "export SYSTEMD_PAGER=cat",
      "export EDITOR=cat",
      "export VISUAL=cat",
      "export DEBIAN_FRONTEND=noninteractive",
      "",
      "# Функции для логирования",
      "error() {",
      "    echo \"ERROR: $*\" >&2",
      "    exit 1",
      "}",
      "",
      "warn() {",
      "    echo \"WARNING: $*\" >&2",
      "}",
      "",
      "info() {",
      "    echo \"INFO: $*\"",
      "}",
      "",
      "# Основной код",
      "$0"
    ],
    "description": "Bash script template with error handling"
  },
  "Retry with Backoff": {
    "prefix": "retry-backoff",
    "body": [
      "retry_with_backoff() {",
      "    local max_retries=15",
      "    local retry_count=0",
      "    local wait_time=1",
      "    ",
      "    while [ $retry_count -lt $max_retries ]; do",
      "        if \"$@\"; then",
      "            return 0",
      "        fi",
      "        ",
      "        retry_count=$((retry_count + 1))",
      "        wait_time=$((2 ** retry_count))",
      "        [ $wait_time -gt 60 ] && wait_time=60  # Max 60 секунд",
      "        ",
      "        echo \"Retry $retry_count/$max_retries after ${wait_time}s...\"",
      "        sleep $wait_time",
      "    done",
      "    ",
      "    echo \"ERROR: Failed after $max_retries attempts\"",
      "    return 1",
      "}"
    ],
    "description": "Retry function with exponential backoff"
  },
  "Cleanup Function": {
    "prefix": "cleanup",
    "body": [
      "# Временные файлы",
      "TEMP_DIR=$(mktemp -d)",
      "",
      "# Cleanup функция",
      "cleanup() {",
      "    local exit_code=$?",
      "    echo \"Cleaning up...\"",
      "    rm -rf \"$TEMP_DIR\"",
      "    exit $exit_code",
      "}",
      "",
      "# Вызвать cleanup при выходе",
      "trap cleanup EXIT INT TERM"
    ],
    "description": "Cleanup function with trap"
  },
  "Validate Input Parameters": {
    "prefix": "validate-params",
    "body": [
      "# Проверка наличия параметров",
      "if [ $# -lt ${1:2} ]; then",
      "    echo \"Usage: $0 <${2:param1}> <${3:param2}>\"",
      "    exit 1",
      "fi",
      "",
      "${4:PARAM1}=$1",
      "${5:PARAM2}=$2",
      "",
      "# Проверка значений",
      "if [ -z \"$${4:PARAM1}\" ] || [ -z \"$${5:PARAM2}\" ]; then",
      "    echo \"ERROR: Parameters cannot be empty\"",
      "    exit 1",
      "fi"
    ],
    "description": "Input parameter validation"
  }
}

