# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Debian package scripts (no extension)
debian/postinst text eol=lf
debian/prerm text eol=lf
debian/postrm text eol=lf
debian/preinst text eol=lf
debian/rules text eol=lf
debian/control text eol=lf
debian/install text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ipk binary
*.tar binary
*.gz binary
*.xz binary
