{
  "mcpServers": {
    "ultracode": {
      "command": "C:\\Users\\Администратор\\AppData\\Local\\Microsoft\\WinGet\\Links\\bun.exe",
      "args": [
        "C:\\Git\\ultracode\\dist\\index.js",
        "C:\\Git\\openwrt-captive-monitor"
      ],
      "autoApprove": [
        "index",
        "get_graph_stats",
        "get_version",
        "list_file_entities",
        "semantic_search",
        "query"
      ]
    },
    "echovault": {
      "command": "C:\\Users\\Администратор\\AppData\\Local\\Programs\\Python\\Python312\\Scripts\\memory.exe",
      "args": [
        "mcp"
      ],
      "autoApprove": [
        "mcp_echovault_memory_search",
        "mcp_echovault_memory_get_all",
        "mcp_echovault_memory_get_by_id"
      ]
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-everything"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Git"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_TOKEN_HERE"
      }
    }
  }
}
