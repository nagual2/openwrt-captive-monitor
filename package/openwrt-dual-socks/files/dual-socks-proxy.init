#!/bin/sh /etc/rc.common
# Dual SOCKS Proxy for OpenWrt
# POSIX sh compatible init script

START=99
STOP=01

USE_PROCD=1
PROG=/usr/bin/dual-socks-proxy

start_service() {
    local enabled
    config_load dual-socks-proxy
    config_get enabled main enabled 0
    
    [ "$enabled" = "1" ] || {
        echo "dual-socks-proxy is disabled"
        return 0
    }
    
    procd_open_instance
    procd_set_param command $PROG start
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    $PROG stop
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "dual-socks-proxy"
    procd_add_reload_trigger "network"
}
