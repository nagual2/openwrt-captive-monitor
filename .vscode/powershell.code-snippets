{
  "Git Feature Branch": {
    "prefix": "git-feature",
    "body": [
      "# Создать feature branch",
      "git checkout -b feature/${1:feature-name}",
      "",
      "# Сделать изменения и коммит",
      "git add .",
      "git commit -m \"${2|feat,fix,docs,ci,refactor,test,chore|}: ${3:description}\"",
      "",
      "# Push и создать PR",
      "git push origin feature/${1:feature-name}",
      "gh pr create --title \"${2}: ${3}\" --body \"${4:Description}\""
    ],
    "description": "Git feature branch workflow"
  },
  "Docker Build SDK": {
    "prefix": "docker-sdk",
    "body": [
      "docker build `",
      "  --build-arg OPENWRT_VERSION=${1:23.05.5} `",
      "  --build-arg SDK_TARGET=${2:x86} `",
      "  --build-arg SDK_SUBTARGET=${3:64} `",
      "  -t openwrt-sdk:${2}-${3} `",
      "  -f docker/sdk/Dockerfile `",
      "  ."
    ],
    "description": "Build OpenWrt SDK Docker image"
  },
  "GitHub Workflow Run": {
    "prefix": "gh-run",
    "body": [
      "# Запустить workflow",
      "gh workflow run \"${1:workflow-name}\" --ref \\$(git branch --show-current)",
      "",
      "# Проверить статус",
      "gh run list --limit 5"
    ],
    "description": "Run GitHub workflow"
  },
  "SSH OpenWrt": {
    "prefix": "ssh-openwrt",
    "body": [
      "# Подключиться к OpenWrt",
      "ssh root@192.168.35.127",
      "",
      "# Выполнить команду",
      "ssh root@192.168.35.127 \"${1:command}\"",
      "",
      "# Скопировать файл",
      "scp ${2:local-file} root@192.168.35.127:/tmp/"
    ],
    "description": "SSH to OpenWrt test router"
  },
  "Error Handling": {
    "prefix": "try-catch",
    "body": [
      "try {",
      "    ${1:# Code}",
      "}",
      "catch {",
      "    Write-Host \"ERROR: \\$_\" -ForegroundColor Red",
      "    exit 1",
      "}"
    ],
    "description": "PowerShell try-catch block"
  }
}
