{
  "claude": {
    "apiProvider": "anthropic",
    "modelId": "claude-3-5-sonnet-20241022",
    "apiTimeoutMs": 30000,
    "contextWindow": {
      "maxTokens": 200000,
      "includeFilePath": true,
      "includeImports": true,
      "includeSymbols": true
    },
    "codeAnalysis": {
      "analyzeOnHover": true,
      "showTypeHints": true,
      "highlightSecurityIssues": true,
      "performanceAnalysis": true
    },
    "projectContext": {
      "roots": [
        "src/",
        "tests/",
        "scripts/"
      ],
      "excludePatterns": [
        "node_modules/",
        ".git/",
        ".pytest_cache/",
        "__pycache__/",
        "*.log"
      ],
      "indexOnStartup": true
    },
    "codeGeneration": {
      "preferredLanguage": "bash",
      "includeComments": true,
      "includeTypeHints": true,
      "includeErrorHandling": true,
      "formatOnGenerate": true
    },
    "chat": {
      "allowSourceQuotes": true,
      "showReferences": true,
      "persistHistory": true,
      "suggestFollowUps": true,
      "enableShortcuts": true
    },
    "refactoring": {
      "preserveLogic": true,
      "improvePerformance": true,
      "enhanceReadability": true,
      "updateTests": true
    },
    "security": {
      "scanForVulnerabilities": true,
      "checkForSecrets": true,
      "validateDependencies": true,
      "warnAboutDeprecations": true
    },
    "projectType": "openwrt",
    "projectLanguages": [
      "shell",
      "makefile",
      "json",
      "yaml",
      "markdown"
    ],
    "customInstructions": "You are helping with OpenWrt package development for a Captive Portal Monitor. Focus on shell scripting best practices, UCI configuration, and OpenWrt/procd compatibility."
  },
  "editor.experimental.clipboardHistoryOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  }
}
