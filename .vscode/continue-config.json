{
  "models": [
    {
      "title": "Grok 4.1 Fast (Free)",
      "provider": "openrouter",
      "model": "x-ai/grok-4.1-fast:free",
      "apiKey": "${OPENROUTER_API_KEY}",
      "contextLength": 8192,
      "completionOptions": {
        "temperature": 0.7,
        "maxTokens": 2048
      }
    },
    {
      "title": "KAT-Coder-Pro (Free)",
      "provider": "openrouter",
      "model": "kwaipilot/kat-coder-pro:free",
      "apiKey": "${OPENROUTER_API_KEY}",
      "contextLength": 16384,
      "completionOptions": {
        "temperature": 0.2,
        "maxTokens": 4096
      }
    },
    {
      "title": "Olmo 3 32B Think (Free)",
      "provider": "openrouter",
      "model": "allenai/olmo-3-32b-think:free",
      "apiKey": "${OPENROUTER_API_KEY}",
      "contextLength": 32768,
      "completionOptions": {
        "temperature": 0.5,
        "maxTokens": 3000
      }
    }
  ],
  "tabAutocompleteModel": {
    "title": "Trinity Mini (Free)",
    "provider": "openrouter",
    "model": "arcee-ai/trinity-mini:free",
    "apiKey": "${OPENROUTER_API_KEY}"
  },
  "customCommands": [
    {
      "name": "test",
      "prompt": "Напиши unit тесты для этого кода:\n\n{{{ input }}}"
    },
    {
      "name": "explain",
      "prompt": "Объясни этот код на русском:\n\n{{{ input }}}"
    },
    {
      "name": "fix",
      "prompt": "Найди и исправь ошибки в этом коде:\n\n{{{ input }}}"
    }
  ],
  "allowAnonymousTelemetry": false,
  "embeddingsProvider": {
    "provider": "openrouter",
    "model": "text-embedding-3-small",
    "apiKey": "${OPENROUTER_API_KEY}"
  }
}
