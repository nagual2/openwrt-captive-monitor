#!/bin/sh
# Mock for ifstatus command

iface="$1"

# Check if mock should return failure
if [ "${MOCK_IFUP_STATUS:-0}" = "0" ]; then
    # Return success - interface is up
    cat << 'EOF'
{
    "up": true,
    "pending": false,
    "available": true,
    "autostart": true,
    "dynamic": false,
    "uptime": 12345,
    "l3_device": "eth1",
    "proto": "dhcp",
    "device": "eth1",
    "updated": ["addresses", "routes"],
    "metric": 0,
    "dns_metric": 0,
    "delegation": true,
    "ipv4-address": [],
    "ipv6-address": [],
    "ipv6-prefix": [],
    "ipv6-prefix-assignment": [],
    "route": [],
    "dns-server": [],
    "dns-search": [],
    "neighbors": [],
    "inactive": {
        "ipv4-address": [],
        "ipv6-address": [],
        "route": [],
        "dns-server": [],
        "dns-search": [],
        "neighbors": []
    },
    "data": {}
}
EOF
else
    # Return failure - interface is down
    cat << 'EOF'
{
    "up": false,
    "pending": false,
    "available": false,
    "autostart": true
}
EOF
fi
