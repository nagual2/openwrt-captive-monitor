#!/bin/sh
set -eu
. "$(dirname "$0")/_lib.sh"

mock_log nslookup "$@"

host=""
for arg in "$@"; do
    case "$arg" in
        -*) ;;
        *)
            if [ -z "$host" ]; then
                host="$arg"
            fi
            ;;
    esac
done

if [ -z "$host" ]; then
    host="captive.test"
fi

ip4="${MOCK_NSLOOKUP_IPV4:-10.10.10.10}"

printf 'Server: %s\n' "${2:-127.0.0.1}"
printf 'Name: %s\n' "$host"
if [ -n "$ip4" ]; then
    printf 'Address 1: %s\n' "$ip4"
fi
exit 0
