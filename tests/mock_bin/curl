#!/bin/sh
# Mock curl

# Log arguments for debugging
# echo "[CURL] $@" >> "$TEST_LOG_FILE"

# 1. Internet Check
# If we are checking the generate_204 URL
for arg in "$@"; do
    if echo "$arg" | grep -q "generate_204"; then
        if [ "$MOCK_INTERNET_STATUS" = "online" ]; then
            printf "204"
            exit 0
        else
            printf "000"
            exit 0
        fi
    fi
done

# 2. Portal Detection (neverssl or others)
for arg in "$@"; do
    if echo "$arg" | grep -q "neverssl.com"; then
        echo "Location: http://portal.mock/login"
        exit 0
    fi
done

# 3. Default response for other calls (like creating session)
echo '{"loggedIn":true,"session":"mock_session_id"}'
